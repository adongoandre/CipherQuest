# =====================================================================
# CipherQuest — environment configuration (TEMPLATE ONLY)
# Copy to `.env` and adjust values. Never commit a real `.env`.
# =====================================================================

# --- Backend application ---
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=replace_with_a_long_random_value

# --- Database ---
# Local development uses SQLite explicitly (see note below).
# The production target is PostgreSQL.
#
# Local development (explicitly configured SQLite — tests/dev only):
DATABASE_URL=sqlite:///./data/cipherquest.db
#
# Production / docker-compose PostgreSQL:
# DATABASE_URL=postgresql+psycopg://cipherquest:change_me@localhost:5432/cipherquest

# --- CORS / frontend origin ---
FRONTEND_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:8000

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
